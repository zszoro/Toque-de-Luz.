MP_MODE=PROD
APP_BASE_URL=http://localhost:5500
# E-mails separados por virgula que podem acessar /admin.html
ADMIN_EMAILS=pattypampas@hotmail.com
# Troque por uma senha forte no site real.
ADMIN_PASSWORD=troque-esta-senha
# Opcional para o painel salvar produtos direto no GitHub e refletir no site real.
GITHUB_REPO=zszoro/Toque-de-Luz.
GITHUB_BRANCH=main
GITHUB_TOKEN=github_pat_xxxxxxxxxxxxxxxxx
# Opcional: para webhook automatico, ou use npm run tunnel (gera .webhook-url automaticamente)
# MP_WEBHOOK_PUBLIC_URL=https://SEU-TUNNEL.aqui

# TEST (sandbox, somente para desenvolvimento)
MP_TEST_PUBLIC_KEY=TEST-XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
MP_TEST_ACCESS_TOKEN=TEST-XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# PROD (real, obrigatorio para receber pagamentos reais)
MP_PROD_PUBLIC_KEY=APP_USR-XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
MP_PROD_ACCESS_TOKEN=APP_USR-XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
